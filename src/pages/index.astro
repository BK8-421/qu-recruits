---
const sheetUrl = "https://docs.google.com/spreadsheets/d/1Set4M9dBQph46UBuWCptwteMuZN-GFmQKmRsGHTSLac/gviz/tq?tqx=out:csv&gid=2043950204";

let recruits = [];

try {
  const response = await fetch(sheetUrl);
  const csvText = await response.text();

  if (response.ok && !csvText.trim().startsWith('<')) {
    const lines = csvText.trim().split('\n').slice(1);
    recruits = lines.map(line => {
      let cols = [];
      let current = '';
      let inQuotes = false;
      
      for (let i = 0; i < line.length; i++) {
        let char = line[i];
        if (char === '"') {
          inQuotes = !inQuotes;
        } else if (char === ',' && !inQuotes) {
          cols.push(current.trim().replace(/^"|"$/g, ''));
          current = '';
        } else {
          current += char;
        }
      }
      cols.push(current.trim().replace(/^"|"$/g, ''));

      const pos = cols[1] || '';
      const isGoalie = pos.toUpperCase() === 'G';

      return {
        name: cols[0] || '',
        pos: pos,
        team: cols[2] || '',
        league: cols[3] || '',
        commitYear: cols[4] || '',
        isGoalie: isGoalie,
        // Skater stats: GP, G, A, PTS
        gp: cols[7] || '0',
        g: cols[8] || '0',
        a: cols[9] || '0',
        pts: cols[10] || '0',
        // Goalie stats: GP, GAA (Goals Against Average), SV% (Save Percentage), W/L if applicable in columns 7-10
        // Adjust these indexes depending on how your goalie columns are laid out in the sheet
        goalieStat1: cols[7] || '0', // e.g., GP
        goalieStat2: cols[8] || '0', // e.g., Record (W-L-T)
        goalieStat3: cols[9] || '0', // e.g., GAA
        goalieStat4: cols[10] || ''  // e.g., SV%
      };
    }).filter(p => p.name !== '' && p.name !== 'Name');
  }
} catch (error) {
  console.error("Error fetching sheet data:", error);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quinnipiac Hockey Recruit Tracker</title>
  </head>
  <body>
    <main>
      <header>
        <h1>Quinnipiac Hockey Recruit Tracker</h1>
        <p>Tracking future Bobcats across junior leagues in real time.</p>
      </header>

      <div class="table-container">
        <table id="recruits-table">
          <thead>
            <tr>
              <th data-column="0" class="sortable">Name <span>↕</span></th>
              <th data-column="1" class="sortable">Pos <span>↕</span></th>
              <th data-column="2" class="sortable">Current Team <span>↕</span></th>
              <th data-column="3" class="sortable">League <span>↕</span></th>
              <th data-column="4" class="sortable">Commit Year <span>↕</span></th>
              <th data-column="5" class="sortable">GP <span>↕</span></th>
              <th data-column="6" class="sortable">G / W <span>↕</span></th>
              <th data-column="7" class="sortable">A / GAA <span>↕</span></th>
              <th data-column="8" class="sortable">PTS / SV% <span>↕</span></th>
            </tr>
          </thead>
          <tbody>
            {recruits.length > 0 ? (
              recruits.map((player) => (
                <tr>
                  <td class="player-name">{player.name}</td>
                  <td>{player.pos}</td>
                  <td>{player.team}</td>
                  <td><span class="badge">{player.league}</span></td>
                  <td>{player.commitYear}</td>
                  {player.isGoalie ? (
                    <>
                      <td>{player.goalieStat1}</td>
                      <td>{player.goalieStat2}</td>
                      <td>{player.goalieStat3}</td>
                      <td class="pts-cell">{player.goalieStat4}</td>
                    </>
                  ) : (
                    <>
                      <td>{player.gp}</td>
                      <td>{player.g}</td>
                      <td>{player.a}</td>
                      <td class="pts-cell">{player.pts}</td>
                    </>
                  )}
                </tr>
              ))
            ) : (
              <tr>
                <td colspan="9" class="no-data">No recruit data found. Check your Google Sheet URL.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </main>

    <script>
      const table = document.getElementById('recruits-table');
      const headers = table.querySelectorAll('th.sortable');
      let currentSortColumn = -1;
      let isAscending = true;

      headers.forEach(header => {
        header.addEventListener('click', () => {
          const colIndex = parseInt(header.getAttribute('data-column'));
          const tbody = table.querySelector('tbody');
          const rows = Array.from(tbody.querySelectorAll('tr'));

          if (currentSortColumn === colIndex) {
            isAscending = !isAscending;
          } else {
            currentSortColumn = colIndex;
            isAscending = true;
          }

          headers.forEach(h => h.classList.remove('sorted-asc', 'sorted-desc'));
          header.classList.add(isAscending ? 'sorted-asc' : 'sorted-desc');

          rows.sort((a, b) => {
            let cellA = a.children[colIndex].textContent.trim();
            let cellB = b.children[colIndex].textContent.trim();

            let valA = isNaN(cellA) ? cellA.toLowerCase() : parseFloat(cellA);
            let valB = isNaN(cellB) ? cellB.toLowerCase() : parseFloat(cellB);

            if (valA < valB) return isAscending ? -1 : 1;
            if (valA > valB) return isAscending ? 1 : -1;
            return 0;
          });

          rows.forEach(row => tbody.appendChild(row));
        });
      });
    </script>

    <style>
      :root {
        --qu-navy: #0a192f;
        --qu-gold: #e0a96d;
        --card-bg: #112240;
        --border-color: #233554;
        --text-main: #e6f1ff;
        --text-muted: #8892b0;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: var(--qu-navy);
        color: var(--text-main);
        margin: 0;
        padding: 2rem 1rem;
      }

      main {
        max-width: 1000px;
        margin: 0 auto;
      }

      header {
        margin-bottom: 2rem;
      }

      h1 {
        color: var(--qu-gold);
        font-size: 2.25rem;
        margin: 0 0 0.5rem 0;
      }

      p {
        color: var(--text-muted);
        font-size: 1.1rem;
        margin: 0;
      }

      .table-container {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        overflow-x: auto;
        box-shadow: 0 10px 30px -15px rgba(2, 12, 27, 0.7);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
      }

      th, td {
        padding: 14px 18px;
        border-bottom: 1px solid var(--border-color);
      }

      th {
        background-color: #0d1d38;
        color: var(--qu-gold);
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        cursor: pointer;
        user-select: none;
        transition: background-color 0.2s;
      }

      th:hover {
        background-color: #13274a;
      }

      th span {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-left: 4px;
      }

      th.sorted-asc span::after {
        content: " ▲";
        color: var(--qu-gold);
      }

      th.sorted-desc span::after {
        content: " ▼";
        color: var(--qu-gold);
      }

      tr:hover {
        background-color: rgba(255, 255, 255, 0.03);
      }

      .player-name {
        font-weight: 600;
        color: #ffffff;
      }

      .pts-cell {
        font-weight: 700;
        color: var(--qu-gold);
      }

      .badge {
        background-color: var(--border-color);
        color: var(--text-main);
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
      }

      .no-data {
        text-align: center;
        color: var(--text-muted);
        padding: 2rem;
      }
    </style>
  </body>
</html>