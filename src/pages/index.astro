---
const sheetUrl = "https://docs.google.com/spreadsheets/d/1Set4M9dBQph46UBuWCptwteMuZN-GFmQKmRsGHTSLac/gviz/tq?tqx=out:csv&gid=2043950204";

let skaters = [];
let goalies = [];

try {
  const response = await fetch(sheetUrl);
  const csvText = await response.text();

  if (response.ok && !csvText.trim().startsWith('<')) {
    const lines = csvText.trim().split('\n').slice(1);
    const recruits = lines.map(line => {
      let cols = [];
      let current = '';
      let inQuotes = false;
      
      for (let i = 0; i < line.length; i++) {
        let char = line[i];
        if (char === '"') {
          inQuotes = !inQuotes;
        } else if (char === ',' && !inQuotes) {
          cols.push(current.trim().replace(/^"|"$/g, ''));
          current = '';
        } else {
          current += char;
        }
      }
      cols.push(current.trim().replace(/^"|"$/g, ''));

      const pos = (cols[1] || '').trim().toUpperCase();
      const isGoalie = pos === 'G';

      if (isGoalie) {
        return {
          type: 'goalie',
          name: cols[0] || '',
          pos: pos,
          team: cols[2] || '',
          league: cols[3] || '',
          commitYear: cols[4] || '',
          gp: cols[7] || '0',
          record: cols[8] || '0-0',
          gaa: cols[9] || '0.00',
          svPct: cols[10] || '.000'
        };
      } else {
        return {
          type: 'skater',
          name: cols[0] || '',
          pos: pos,
          team: cols[2] || '',
          league: cols[3] || '',
          commitYear: cols[4] || '',
          gp: cols[7] || '0',
          g: cols[8] || '0',
          a: cols[9] || '0',
          pts: cols[10] || '0'
        };
      }
    }).filter(p => p.name !== '' && p.name !== 'Name');

    skaters = recruits.filter(p => p.type === 'skater');
    goalies = recruits.filter(p => p.type === 'goalie');
  }
} catch (error) {
  console.error("Error fetching sheet data:", error);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quinnipiac Hockey Recruit Tracker</title>
  </head>
  <body>
    <main>
      <header>
        <h1>Quinnipiac Hockey Recruit Tracker</h1>
        <p>Tracking future Bobcats across junior leagues in real time.</p>
      </header>

      <!-- Skaters Section -->
      <section class="table-section">
        <h2>Skaters</h2>
        <div class="table-container">
          <table id="skaters-table">
            <thead>
              <tr>
                <th data-column="0" class="sortable">Name <span>↕</span></th>
                <th data-column="1" class="sortable">Pos <span>↕</span></th>
                <th data-column="2" class="sortable">Current Team <span>↕</span></th>
                <th data-column="3" class="sortable">League <span>↕</span></th>
                <th data-column="4" class="sortable">Commit Year <span>↕</span></th>
                <th data-column="5" class="sortable">GP <span>↕</span></th>
                <th data-column="6" class="sortable">G <span>↕</span></th>
                <th data-column="7" class="sortable">A <span>↕</span></th>
                <th data-column="8" class="sortable">PTS <span>↕</span></th>
              </tr>
            </thead>
            <tbody>
              {skaters.length > 0 ? (
                skaters.map((player) => (
                  <tr>
                    <td class="player-name">{player.name}</td>
                    <td>{player.pos}</td>
                    <td>{player.team}</td>
                    <td><span class="badge">{player.league}</span></td>
                    <td>{player.commitYear}</td>
                    <td>{player.gp}</td>
                    <td>{player.g}</td>
                    <td>{player.a}</td>
                    <td class="pts-cell">{player.pts}</td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colspan="9" class="no-data">No skater data found.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Goalies Section -->
      <section class="table-section">
        <h2>Goalies</h2>
        <div class="table-container">
          <table id="goalies-table">
            <thead>
              <tr>
                <th data-column="0" class="sortable">Name <span>↕</span></th>
                <th data-column="1" class="sortable">Pos <span>↕</span></th>
                <th data-column="2" class="sortable">Current Team <span>↕</span></th>
                <th data-column="3" class="sortable">League <span>↕</span></th>
                <th data-column="4" class="sortable">Commit Year <span>↕</span></th>
                <th data-column="5" class="sortable">GP <span>↕</span></th>
                <th data-column="6" class="sortable">Record (W-L) <span>↕</span></th>
                <th data-column="7" class="sortable">GAA <span>↕</span></th>
                <th data-column="8" class="sortable">SV% <span>↕</span></th>
              </tr>
            </thead>
            <tbody>
              {goalies.length > 0 ? (
                goalies.map((goalie) => (
                  <tr>
                    <td class="player-name">{goalie.name}</td>
                    <td>{goalie.pos}</td>
                    <td>{goalie.team}</td>
                    <td><span class="badge">{goalie.league}</span></td>
                    <td>{goalie.commitYear}</td>
                    <td>{goalie.gp}</td>
                    <td>{goalie.record}</td>
                    <td>{goalie.gaa}</td>
                    <td class="pts-cell">{goalie.svPct}</td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colspan="9" class="no-data">No goalie data found.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <script>
      function makeTableSortable(tableId) {
        const table = document.getElementById(tableId);
        if (!table) return;
        const headers = table.querySelectorAll('th.sortable');
        let currentSortColumn = -1;
        let isAscending = true;

        headers.forEach(header => {
          header.addEventListener('click', () => {
            const colIndex = parseInt(header.getAttribute('data-column'));
            const tbody = table.querySelector('tbody');
            const rows = Array.from(tbody.querySelectorAll('tr'));

            if (currentSortColumn === colIndex) {
              isAscending = !isAscending;
            } else {
              currentSortColumn = colIndex;
              isAscending = true;
            }

            headers.forEach(h => h.classList.remove('sorted-asc', 'sorted-desc'));
            header.classList.add(isAscending ? 'sorted-asc' : 'sorted-desc');

            rows.sort((a, b) => {
              let cellA = a.children[colIndex].textContent.trim();
              let cellB = b.children[colIndex].textContent.trim();

              let valA = isNaN(cellA) ? cellA.toLowerCase() : parseFloat(cellA);
              let valB = isNaN(cellB) ? cellB.toLowerCase() : parseFloat(cellB);

              if (valA < valB) return isAscending ? -1 : 1;
              if (valA > valB) return isAscending ? 1 : -1;
              return 0;
            });

            rows.forEach(row => tbody.appendChild(row));
          });
        });
      }

      makeTableSortable('skaters-table');
      makeTableSortable('goalies-table');
    </script>

    <style>
      :root {
        --qu-navy: #0a192f;
        --qu-gold: #e0a96d;
        --card-bg: #112240;
        --border-color: #233554;
        --text-main: #e6f1ff;
        --text-muted: #8892b0;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: var(--qu-navy);
        color: var(--text-main);
        margin: 0;
        padding: 2rem 1rem;
      }

      main {
        max-width: 1000px;
        margin: 0 auto;
      }

      header {
        margin-bottom: 2rem;
      }

      h1 {
        color: var(--qu-gold);
        font-size: 2.25rem;
        margin: 0 0 0.5rem 0;
      }

      p {
        color: var(--text-muted);
        font-size: 1.1rem;
        margin: 0;
      }

      .table-section {
        margin-bottom: 2.5rem;
      }

      .table-section h2 {
        color: var(--text-main);
        font-size: 1.5rem;
        margin-bottom: 1rem;
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 0.5rem;
      }

      .table-container {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        overflow-x: auto;
        box-shadow: 0 10px 30px -15px rgba(2, 12, 27, 0.7);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
      }

      th, td {
        padding: 14px 18px;
        border-bottom: 1px solid var(--border-color);
      }

      th {
        background-color: #0d1d38;
        color: var(--qu-gold);
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        cursor: pointer;
        user-select: none;
        transition: background-color 0.2s;
      }

      th:hover {
        background-color: #13274a;
      }

      th span {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-left: 4px;
      }

      th.sorted-asc span::after {
        content: " ▲";
        color: var(--qu-gold);
      }

      th.sorted-desc span::after {
        content: " ▼";
        color: var(--qu-gold);
      }

      tr:hover {
        background-color: rgba(255, 255, 255, 0.03);
      }

      .player-name {
        font-weight: 600;
        color: #ffffff;
      }

      .pts-cell {
        font-weight: 700;
        color: var(--qu-gold);
      }

      .badge {
        background-color: var(--border-color);
        color: var(--text-main);
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
      }

      .no-data {
        text-align: center;
        color: var(--text-muted);
        padding: 2rem;
      }
    </style>
  </body>
</html>